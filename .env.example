# ==============================================================================
# CASONA LOS RODRÍGUEZ — CONFIGURACIÓN DE VARIABLES DE ENTORNO EN PRODUCCIÓN
# ==============================================================================
# INSTRUCCIONES PARA PRODUCCIÓN:
# 1. Copia este archivo y renómbralo como `.env.local` en la raíz del proyecto.
# 2. Si usas tu servidor de correo en Hostinger, llena la SECCIÓN 2 (SMTP).
# 3. Si despliegas en un hosting (Vercel, Netlify, VPS o Hostinger Node.js),
#    agrega estas variables en su panel de "Environment Variables".
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DOMINIO Y MOTOR DE RESERVAS (PÚBLICO)
# ------------------------------------------------------------------------------
# Dominio oficial en producción (usado para SEO, URLs canónicas y OpenGraph)
NEXT_PUBLIC_SITE_URL=https://casonalosrodriguez.cr

# URL del motor de reservas externo (ej: FareHarbor, Peek, Bokun, Checkfront)
# Si no hay motor externo activado, el sitio usa la reserva directa por WhatsApp por defecto.
NEXT_PUBLIC_BOOKING_URL=TODO_BOOKING_URL

# ID de Seguimiento de Google Analytics 4 (ejemplo: G-XXXXXXXXXX)
# Déjalo en blanco si aún no has creado la propiedad en Google Analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=


# ------------------------------------------------------------------------------
# 2. CONFIGURACIÓN DE CORREO SMTP DE HOSTINGER (RECOMENDADO / PRINCIPAL)
# ------------------------------------------------------------------------------
# Servidor SMTP de Hostinger (Predeterminado: smtp.hostinger.com)
SMTP_HOST=smtp.hostinger.com

# Puerto de Hostinger SMTP (465 para SSL/TLS o 587 para STARTTLS)
SMTP_PORT=465

# Usuario/Correo de la cuenta creada en Hostinger (ej: info@casonalosrodriguez.cr)
SMTP_USER=info@casonalosrodriguez.cr

# Contraseña de la cuenta de correo creada en el panel de Hostinger
SMTP_PASS=TU_CONTRASEÑA_DE_HOSTINGER_AQUI


# ------------------------------------------------------------------------------
# 3. DESTINATARIOS Y REMITENTE
# ------------------------------------------------------------------------------
# Remitente que aparecerá en la casilla del destinatario
EMAIL_FROM=Casona Los Rodríguez <info@casonalosrodriguez.cr>

# Correo receptor para solicitudes del Formulario de Contacto General
CONTACT_EMAIL_TO=info@casonalosrodriguez.cr

# Correo receptor para solicitudes del Formulario de Cotización de Agencias B2B
AGENCY_EMAIL_TO=agencias@casonalosrodriguez.cr


# ------------------------------------------------------------------------------
# 4. MOTOR SECUNDARIO / OPCIONAL (RESEND API)
# ------------------------------------------------------------------------------
# Opcional: Solo si prefieres usar la API de Resend en lugar de Hostinger SMTP.
# Si los valores SMTP de Hostinger están llenos arriba, el sistema usará Hostinger por defecto.
RESEND_API_KEY=
